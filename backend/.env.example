# Copy this file to .env and edit the values
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendance_db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Face matching: cosine similarity needed to accept a match (SFace recommended: 0.363)
FACE_MATCH_THRESHOLD=0.363
